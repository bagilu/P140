      "routeId": "hualien_302",
      "shortName": "302",
      "name": "302 新城火車站－太魯閣遊客中心（縮駛）",
      "color": "#e8635c",
      "isDemo": false,
      "sources": {
        "official_schedule": {
          "kind": "official",
          "authority": "太魯閣客運",
          "description": "使用者提供的302路線與時刻圖：平日及例假日往返各12班；只公布新城車站及太魯閣遊客中心起站時刻。未標明班表生效日期。",
          "url": "https://tarokobus.webnode.tw/l/302/",
          "retrievedAt": "2026-10-24",
          "effectiveDate": null
        },
        "official_service_scope": {
          "kind": "official",
          "authority": "太魯閣客運",
          "description": "附件紅字及業者302網頁均註明因路段管制，現階段僅行駛至太魯閣遊客中心。原線名為新城火車站－天祥；本檔只模擬縮駛區間。網頁文章日期2024-07-11不逕作班表生效日。",
          "url": "https://tarokobus.webnode.tw/l/302/",
          "retrievedAt": "2026-10-24"
        },
        "official_addresses": {
          "kind": "official",
          "authority": "太魯閣客運",
          "description": "使用者提供302雙向站址表。太魯閣國家公園為富世村富世291號；停駛區間的砂卡噹去程單邊、長春祠回程單邊等資訊僅保留來源，不納入本檔行駛站點。",
          "url": "https://tarokobus.webnode.tw/l/302/",
          "retrievedAt": "2026-10-24"
        },
        "government_positions": {
          "kind": "official",
          "authority": "花蓮縣政府",
          "description": "交通e點通302各方向完整14站快照，依業者縮駛公告選取各7站。保留各方向政府座標與站牌UID；沒有使用EstimateArrival即時欄位。政府太魯閣國家公園站顯示為太魯閣遊客中心。",
          "url": "https://110traffic.hl.gov.tw/Bus/BusArrivelTime?from=arrival&input=302",
          "retrievedAt": "2026-10-24"
        },
        "osrm_roads": {
          "kind": "routing",
          "description": "OSRM driving依7站方向別座標產生的道路候選，尚未確認實際公車走法。",
          "url": "https://project-osrm.org/",
          "retrievedAt": "2026-10-24"
        },
        "estimated_times": {
          "kind": "estimated",
          "description": "各站間路由時間×1.2，四捨五入至少1秒；另加每站停20秒、起站0秒。沒有官方逐站時間，1.2未經實測校準；不是即時GPS或官方到站時刻。",
          "retrievedAt": "2026-10-24"
        },
